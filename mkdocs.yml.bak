site_name: Libro del Desarrollador Web — Urukais
site_description: "Material completo para aprender desarrollo web desde cero: HTML, CSS, JavaScript y más."
site_author: Manuel Casimiro Carrasco (Urukais)
site_url: https://libro.urukais.com/
repo_name: urukaisk-maker/Libro-desarrollador-Web-Urukais-
repo_url: https://github.com/urukaisk-maker/Libro-desarrollador-Web-Urukais-

theme:
  name: material
  language: es
  custom_dir: overrides
  logo: assets/favicon.svg
  favicon: assets/favicon.svg
  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.footer
    - search.suggest
    - search.highlight
    - content.code.copy
    - toc.integrate
  palette:
    - scheme: default
      primary: deep purple
      accent: cyan
      toggle:
        icon: material/weather-night
        name: Cambiar a modo oscuro
    - scheme: slate
      primary: deep purple
      accent: cyan
      toggle:
        icon: material/weather-sunny
        name: Cambiar a modo claro

